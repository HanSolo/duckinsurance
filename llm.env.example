# Language model settings of DuckInsurance, in one place. Edit this file, then run: docker compose up -d   (no rebuild needed).
# compose.yaml loads it into the environment of the container; the application reads it with MicroProfile Config.
# Do not commit a real API key (llm.env is in .gitignore; llm.env.example is the template).
#
# Used by the Assistant page (own client, Anthropic Messages API format) and by the fraud agent
# (the LargeLanguageModel of Payara's Jakarta Agentic AI, see META-INF/microprofile-config.properties).

# Local Ollama on the host (0.14 or newer serves the Anthropic Messages API). Any text works as the key.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b
LLM_API_KEY=ollama
# Provider of the fraud agent. Only "ollama" is verified, see README "Using a cloud model".
LLM_PROVIDER=ollama

# Optional settings of the Assistant:
# ANTHROPIC_MAX_TOKENS=1024
# AGENT_MAX_ROUNDS=8

# Claude in the cloud instead (Assistant only for now):
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=<a Claude model name from your account>
