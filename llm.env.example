# Language model settings of DuckInsurance, in one place. Copy to llm.env, edit, then run: docker compose up -d   (no rebuild needed).
# compose.yaml loads it into the environment of the container; the application reads it with MicroProfile Config.
# Do not commit a real API key (llm.env is in .gitignore; llm.env.example is the template).
#
# Used by the fraud and pre-authorization agents (agent/ConfiguredLlm) and by the Assistant page (chat/AnthropicLlm or chat/OpenAiLlm), all with the same LLM_* values.
# Use the same values in all three applications, so that all agents talk to the same model.

# ---- Option A: local Ollama on the host (default).
# On Linux start Ollama with OLLAMA_HOST=0.0.0.0 ollama serve, so that the container can reach it.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b
LLM_API_KEY=ollama

# ---- Option B: Claude through the Anthropic API. Comment out option A and fill in:
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=<a Claude model name your API account can use>
# LLM_API_KEY=sk-ant-...

# ---- Option C: any service with the OpenAI Chat Completions format. Comment out option A and fill in.
# LLM_BASE_URL includes the version path, for example:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1
#   Ollama      http://host.docker.internal:11434/v1
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<a model name of that service>
# LLM_API_KEY=<key of that service>

# Optional: answer length. anthropic: default 1024. openai: no limit is sent unless you set it
# (newer OpenAI models reject this field; Groq, OpenRouter and Mistral accept it).
# LLM_MAX_TOKENS=1024

# Optional: a different model for the Assistant page only (same names with ASSISTANT_ instead of LLM_):
# ASSISTANT_PROVIDER=anthropic
# ASSISTANT_BASE_URL=https://api.anthropic.com
# ASSISTANT_MODEL=<model>
# ASSISTANT_API_KEY=<key>

# Optional settings of the Assistant:
# ANTHROPIC_MAX_TOKENS=1024
# AGENT_MAX_ROUNDS=8
