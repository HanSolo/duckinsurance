# Language model settings of DuckInsurance, in one place. Copy to llm.env, edit, then run: docker compose up -d   (no rebuild needed).
# compose.yaml loads it into the environment of the container; the application reads it with MicroProfile Config.
# Do not commit a real API key (llm.env is in .gitignore; llm.env.example is the template).
#
# Used by the Assistant page (own client, Anthropic Messages API format) and by the fraud and pre-authorization agents
# (the LargeLanguageModel of Payara's Jakarta Agentic AI, see META-INF/microprofile-config.properties).
# Use the same values in all three applications, so that all agents talk to the same model.

# ---- Option A: local Ollama on the host (0.14 or newer serves the Anthropic Messages API). Any text works as the key.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b
LLM_API_KEY=ollama

# ---- Option B: Claude through the Anthropic API (Assistant and both agents). Comment out option A and fill in:
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=<a Claude model name your API account can use>
# LLM_API_KEY=sk-ant-...

# Optional settings of the Assistant:
# ANTHROPIC_MAX_TOKENS=1024
# AGENT_MAX_ROUNDS=8
# Optional: answer length of the agents (Payara default 4096)
# PAYARA_AGENTIC_LLM_MAX_TOKENS=1024
